{
  "name": "use-smart-loading",
  "version": "0.2.0",
  "description": "A React hook for async loading state with a minimum loader duration and an optional loader delay",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p demo/tsconfig.json",
    "demo": "vite demo",
    "demo:build": "vite build demo",
    "prepublishOnly": "npm run build",
    "test": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmanWasti9/use-smart-loading.git"
  },
  "homepage": "https://github.com/AmanWasti9/use-smart-loading#readme",
  "bugs": {
    "url": "https://github.com/AmanWasti9/use-smart-loading/issues"
  },
  "keywords": [
    "react",
    "hook",
    "loading",
    "ux"
  ],
  "author": "Syed Amanullah Wasti",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=16.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.1",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.3.7",
    "happy-dom": "^21.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  }
}
